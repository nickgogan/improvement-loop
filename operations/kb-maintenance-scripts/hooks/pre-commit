#!/bin/sh
# MetaSystem governance pre-commit hook. Four checks:
#   1. Frontmatter YAML validity on staged markdown (session 128 / DD-114) — blocks the
#      session-127 defect class (unparseable frontmatter) at the gate.
#   2. FOUNDATIONS.md spine map in sync with DD `foundational` flags (DD-115).
#   3. Engine PROGRESS.md line budget (restructure-program Phase 0, session 138) — the
#      forward-only control surface stays on the cold-start critical path: warn past the
#      soft cap, block past the hard cap. Remedy is /session-handoff route-then-compact,
#      never raising the cap.
#   4. Self-improvement store schema (IB-176) — store_check.py over operations/self/
#      when any of its files are staged; schema violations block, PROMOTE/growth
#      signals are advisory.
#
# This is the TRACKED master copy. Install it into the live hooks dir with:
#   ln -sf ../../systems/improvement-loop/operations/kb-maintenance-scripts/hooks/pre-commit .git/hooks/pre-commit
# (or copy it). Bypass a single commit with: git commit --no-verify
repo_root=$(git rev-parse --show-toplevel)
scripts="$repo_root/systems/improvement-loop/operations/kb-maintenance-scripts"
status=0

# 1. Frontmatter YAML validity on staged markdown
files=$(git diff --cached --name-only --diff-filter=ACM -- '*.md')
if [ -n "$files" ]; then
  printf '%s\n' "$files" | sed "s|^|$repo_root/|" | PYTHONPATH="$scripts" python3 "$scripts/validate_frontmatter.py" || status=1
fi

# 2. FOUNDATIONS.md must reflect the current set of DD `foundational: true` flags
PYTHONPATH="$scripts" python3 "$scripts/generate_foundations.py" --check || status=1

# 3. Engine PROGRESS.md line budget (checked only when PROGRESS.md is staged)
progress="systems/improvement-loop/PROGRESS.md"
soft_cap=150
hard_cap=250
if git diff --cached --name-only --diff-filter=ACM | grep -qx "$progress"; then
  n=$(wc -l < "$repo_root/$progress" | tr -d ' ')
  if [ "$n" -gt "$hard_cap" ]; then
    echo "PROGRESS.md exceeds the hard cap ($n > $hard_cap lines) — run /session-handoff route-then-compact; do not raise the cap." >&2
    status=1
  elif [ "$n" -gt "$soft_cap" ]; then
    echo "warning: PROGRESS.md exceeds the soft cap ($n > $soft_cap lines) — route non-critical-path content to HISTORY.md / plans / DDs / IB." >&2
  fi
fi

# 4. Self-improvement store schema (checked only when operations/self/ files are staged)
if git diff --cached --name-only --diff-filter=ACM | grep -q "^systems/improvement-loop/operations/self/"; then
  python3 "$scripts/store_check.py" || status=1
fi

exit $status
