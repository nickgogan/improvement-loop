{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bootstrap-manifest.schema.json",
  "title": "MetaSystem Project Bootstrap Manifest",
  "description": "Drives project creation in incubator/ per DD-48. Consumed by /bootstrap skill. Covers both project identity (metadata) and scaffold (filesystem structure to generate).",
  "type": "object",
  "required": ["identity", "scaffold"],
  "properties": {
    "identity": {
      "type": "object",
      "description": "What the project IS — metadata, ownership, governance.",
      "required": ["name", "description", "type", "owner", "created", "stage"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Kebab-case project name. Becomes the directory name under incubator/."
        },
        "description": {
          "type": "string",
          "maxLength": 280,
          "description": "One-liner explaining what this project does and why it exists."
        },
        "type": {
          "type": "string",
          "enum": ["code", "knowledge", "mixed"],
          "description": "code = scripts/tools/skills. knowledge = guides/patterns/vault content. mixed = both."
        },
        "owner": {
          "type": "string",
          "enum": ["nick", "jr", "shared"],
          "description": "Primary human owner. 'shared' means both Nick and JR."
        },
        "created": {
          "type": "string",
          "format": "date",
          "description": "ISO 8601 date (YYYY-MM-DD) when the project was bootstrapped."
        },
        "stage": {
          "type": "string",
          "enum": ["incubation", "promoted", "archived"],
          "default": "incubation",
          "description": "Lifecycle stage per DD-48. Always starts as 'incubation'."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "default": [],
          "description": "Freeform kebab-case tags for discovery and categorization."
        },
        "governing_dds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^DD-\\d+$"
          },
          "default": [],
          "description": "Design Decisions that constrain or authorize this project."
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "improvement-loop"
            ]
          },
          "default": [],
          "description": "Systems this project reads from or depends on. Only the engine (improvement-loop) is a live system post-collapse (DD-103); archived systems are not valid dependencies for new projects."
        },
        "promotion_criteria": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Conditions for graduation to systems/. Per DD-48: proven value, permanent scope, new DD, Nick's approval."
        }
      },
      "additionalProperties": false
    },
    "scaffold": {
      "type": "object",
      "description": "What to CREATE — filesystem structure, templates, Claude Code config.",
      "required": ["directories"],
      "properties": {
        "directories": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Relative paths under incubator/{name}/ to create."
        },
        "fractal": {
          "type": "boolean",
          "default": true,
          "description": "When true, creates the standard 7-folder fractal structure: app/, governance/, knowledge/ (with patterns/, guides/, templates/, reference/), agents/, project-management/, operations/, archive/. Each with an _index.md file."
        },
        "templates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "target"],
            "properties": {
              "source": {
                "type": "string",
                "description": "Path relative to systems/improvement-loop/knowledge/templates/. The template file to instantiate."
              },
              "target": {
                "type": "string",
                "description": "Path relative to incubator/{name}/. Where to write the instantiated file."
              },
              "variables": {
                "type": "object",
                "additionalProperties": { "type": "string" },
                "description": "Key-value pairs to substitute into the template. Keys match {{KEY}} placeholders."
              }
            },
            "additionalProperties": false
          },
          "default": [],
          "description": "Template files to instantiate from systems/improvement-loop/knowledge/templates/."
        },
        "claude_config": {
          "type": "object",
          "description": "Claude Code configuration to populate .claude/ directory.",
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["source", "filename"],
                "properties": {
                  "source": {
                    "type": "string",
                    "description": "Path relative to systems/improvement-loop/knowledge/templates/. Rule template to copy."
                  },
                  "filename": {
                    "type": "string",
                    "description": "Filename to write in .claude/rules/."
                  }
                },
                "additionalProperties": false
              },
              "default": [],
              "description": "Rule files to place in .claude/rules/."
            },
            "skills": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["source", "skill_name"],
                "properties": {
                  "source": {
                    "type": "string",
                    "description": "Path relative to systems/improvement-loop/knowledge/templates/skill-templates/."
                  },
                  "skill_name": {
                    "type": "string",
                    "description": "Directory name under .claude/skills/."
                  }
                },
                "additionalProperties": false
              },
              "default": [],
              "description": "Skill templates to place in .claude/skills/{skill_name}/SKILL.md."
            },
            "agents": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["source", "filename"],
                "properties": {
                  "source": {
                    "type": "string",
                    "description": "Path relative to systems/improvement-loop/knowledge/templates/agent-templates/."
                  },
                  "filename": {
                    "type": "string",
                    "description": "Filename to write in .claude/agents/."
                  }
                },
                "additionalProperties": false
              },
              "default": [],
              "description": "Agent definition files to place in .claude/agents/."
            },
            "settings": {
              "type": "object",
              "description": "Contents to merge into .claude/settings.json.",
              "default": {}
            }
          },
          "additionalProperties": false
        },
        "components": {
          "type": "object",
          "description": "Additional components beyond the fractal structure.",
          "properties": {
            "progress_tracking": {
              "type": "boolean",
              "default": true,
              "description": "Create PROGRESS.md from template."
            },
            "claude_engine": {
              "type": "boolean",
              "default": true,
              "description": "Create .claude/ directory for Claude Code engine config."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
